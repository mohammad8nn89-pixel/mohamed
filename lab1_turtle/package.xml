<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lab1_turtle</name>
  <version>1.0.0</version>
  <description>goToPose / square action servers, reset and speed services for turtlesim</description>
  <maintainer email="team@example.com">Lab1 Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
